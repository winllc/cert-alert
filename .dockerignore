# Build output: the image builds the jar itself, and copying a host build in would both
# bloat the context and risk shipping something built against a different JDK.
build/
.gradle/
out/
# The accessibility scan (CI only), and its Node packages.
a11y/

# Runtime artefacts that must never reach an image.
data/
logs/
*.log

.git/
.github/
.idea/
.vscode/
*.iml

# Keys and certificates belong in a mounted volume or a secret, never baked in. At any
# depth: a bare *.pem here matches the top of the context only.
*.p12
*.jks
*.pem
*.key
**/*.p12
**/*.jks
**/*.pem
**/*.key
# A license is mounted at run time and never baked into an image.
*.lic
**/*.lic
license/

# Except the test tree's license fixtures, signed with the ENS portal's published TEST key -
# which only the tests trust - so that RUN_TESTS=true still has them. They never leave the
# build stage.
!src/test/resources/license/
!src/test/resources/license/fixtures/
!src/test/resources/license/fixtures/*

README.md
Dockerfile
.dockerignore
docker-compose.yml

# Release bundles and their templates are not part of the image.
dist/
deploy/
