# cert-alert settings. install.sh copies this to .env; edit .env, not this file.
#
# Lines starting with # are not set, and the application's default applies. Every value
# here is passed to the application, so any setting from the documentation can be added as
# its environment variable: cert-alert.ldap.page-size is CERT_ALERT_LDAP_PAGE_SIZE.
#
# .env holds passwords: keep it readable by its owner only (install.sh makes it 0600).
# Values containing spaces, '#' or '$' go in single quotes.
#
# The ENS license is not set here. Put it at license/license.lic for install.sh to install,
# or upload it on the license screen (/admin/license); it lives in the ens-license volume.
# Features marked "licensed" below work only when the installed license includes them.

# ---------------------------------------------------------------------------------------
# REQUIRED - the directory to scrape
# ---------------------------------------------------------------------------------------

# ldaps:// for anything but a lab; the directory's CA must be one the JVM trusts.
CERT_ALERT_LDAP_URL=ldaps://directory.example.gov:636
# Search base everything is found under.
CERT_ALERT_LDAP_BASE=dc=example,dc=gov
# The service account it binds as, and its password. Read access to people, servers and
# their certificates is all it needs - unless directory cleanup is licensed and enabled.
CERT_ALERT_LDAP_USER='cn=cert-alert,ou=services,dc=example,dc=gov'
CERT_ALERT_LDAP_PASSWORD=CHANGE_ME

# Who may trigger jobs and administer the application: comma-separated uids (a DN, which
# has commas of its own, goes in CERT_ALERT_SECURITY_ADMIN_IDENTIFIERS_0, _1, ... instead).
# Never an address - a directory may let people change their own mail, so an address here
# is ignored, with a warning at startup - and never a common name. Everyone else who signs
# in can read but not act.
CERT_ALERT_SECURITY_ADMIN_IDENTIFIERS=CHANGE_ME

# ---------------------------------------------------------------------------------------
# Database - the bundled PostgreSQL
# ---------------------------------------------------------------------------------------

# install.sh fills this in with a random value on first install. It is read when the
# database is first created; changing it later needs ALTER ROLE in the database as well.
#
# The bundled PostgreSQL is reachable only on the bundle's internal Docker network, so the
# connection to it is not encrypted. A PostgreSQL elsewhere (the Helm chart's
# database.params, or CERT_ALERT_DB_URL when running the image yourself) should be reached
# with TLS: append ?sslmode=verify-full (and &sslrootcert=/path/to/ca.pem for a private CA)
# to the JDBC URL. require encrypts without checking who answered; verify-full checks both.
CERT_ALERT_DB_PASSWORD=
# CERT_ALERT_DB_NAME=certalert
# CERT_ALERT_DB_USER=certalert
# CERT_ALERT_DB_POOL_SIZE=10

# ---------------------------------------------------------------------------------------
# Where it listens
# ---------------------------------------------------------------------------------------

# Host port and interface the UI is published on. 127.0.0.1 keeps it to this host, behind
# a reverse proxy of your own. The default, every interface, is for an upgrade to keep
# working as before: with TLS off install.sh warns about it, because passwords and session
# cookies then cross the network in clear text.
# CERT_ALERT_PORT=8080
# CERT_ALERT_BIND_ADDRESS=0.0.0.0

# Behind a reverse proxy that terminates TLS: trust its X-Forwarded-* headers, so redirects,
# the client address in the audit trail and HSTS see the browser's https request rather than
# the proxy's http one. Only with something in front that sets those headers itself.
# SERVER_FORWARD_HEADERS_STRATEGY=framework
# Mark the session cookie Secure whatever the request says (for a proxy that terminates TLS
# and does not send X-Forwarded-Proto). With TLS on in the application it is Secure anyway.
# ENS_COOKIE_SECURE=false
# Report Content-Security-Policy violations instead of enforcing the policy - an escape
# hatch for a page that breaks under it; say so to ENS support. Never leave it on.
# ENS_CSP_REPORT_ONLY=false

# ---------------------------------------------------------------------------------------
# Signing in
# ---------------------------------------------------------------------------------------

# The password fallback: where a username is looked up (relative to CERT_ALERT_LDAP_BASE;
# empty searches the whole tree) and how. Or bind straight to a DN shape instead, for a
# directory that allows no search: CERT_ALERT_SECURITY_LDAP_USER_DN_PATTERNS=uid={0},ou=people
# CERT_ALERT_SECURITY_LDAP_USER_SEARCH_BASE=ou=people
# CERT_ALERT_SECURITY_LDAP_USER_SEARCH_FILTER=(uid={0})
# CERT_ALERT_SECURITY_LDAP_ENABLED=true

# TLS, and with it X.509 client-certificate sign-in. Put the keystores in ./tls next to
# this file; they appear in the container under /etc/cert-alert/tls. The UI is then
# https:// on the same port, TLS 1.2 and 1.3 only.
# CERT_ALERT_TLS_ENABLED=true
# CERT_ALERT_KEYSTORE=file:/etc/cert-alert/tls/keystore.p12
# CERT_ALERT_KEYSTORE_PASSWORD=
# CERT_ALERT_KEYSTORE_TYPE=PKCS12
# The CAs whose client certificates are accepted at the handshake. Required with TLS on:
# the application does not start without one.
# CERT_ALERT_TRUSTSTORE=file:/etc/cert-alert/tls/truststore.p12
# CERT_ALERT_TRUSTSTORE_PASSWORD=
# CERT_ALERT_TRUSTSTORE_TYPE=PKCS12

# Sessions: idle timeout (an administrator's can be shorter - the STIG suggests 15m), a hard
# limit after sign-in, and how many one person may hold (0: no limit; the STIG suggests 3 -
# signing in beyond it ends their oldest). Durations like 30m, 12h.
# ENS_SESSION_IDLE_TIMEOUT=30m
# ENS_SESSION_ADMIN_IDLE_TIMEOUT=
# ENS_SESSION_ABSOLUTE_TIMEOUT=12h
# ENS_SESSION_MAX_PER_USER=0

# The DoD notice-and-consent banner, shown and agreed to before any sign-in (DISA STIG).
# Empty title and text mean the standard USG title and DoD text. The text is plain: blank
# lines separate paragraphs, lines starting "- " make a list. A file (put it in ./tls, which
# is mounted at /etc/cert-alert/tls) wins over the text.
# ENS_CONSENT_BANNER_ENABLED=false
# ENS_CONSENT_BANNER_TITLE=
# ENS_CONSENT_BANNER_TEXT=
# ENS_CONSENT_BANNER_FILE=/etc/cert-alert/tls/consent.txt

# Client certificates (CAC/PIV), on top of the TLS settings above - see the README.
# Revocation checked live at sign-in: off, ocsp, crl or ocsp-then-crl. Unset is
# ocsp-then-crl, soft-fail: a certificate found revoked is refused, and one no OCSP
# responder or CRL answers for signs in with a warning in the log. The STIG requires a
# check; off turns it off.
# ENS_X509_REVOCATION=ocsp-then-crl
# Ask this responder instead of the certificate's own (a local relay on a closed network).
# ENS_X509_OCSP_RESPONDER_URL=
# CRL files (DER or PEM) in a directory, e.g. ./tls/crls; with it set nothing is fetched.
# ENS_X509_CRL_DIR=/etc/cert-alert/tls/crls
# closed refuses a certificate whose status cannot be found, as the STIG expects; open lets
# it in with a warning. Unset: open while ENS_X509_REVOCATION is unset, closed once it is set.
# ENS_X509_REVOCATION_FAIL=closed
# ENS_X509_REVOCATION_CACHE=10m
# Only these issuers, separated by semicolons (a DN has commas of its own).
# ENS_X509_ALLOWED_ISSUERS='CN=DOD ID CA-70,OU=PKI,OU=DoD,O=U.S. Government,C=US;CN=DOD ID CA-71,OU=PKI,OU=DoD,O=U.S. Government,C=US'
# Find the holder of a certificate the directory does not publish, with {upn}, {edipi},
# {email} or {uuid}; needs CERT_ALERT_SECURITY_X509_REQUIRE_KNOWN_CERTIFICATE=false.
# ENS_X509_USER_FILTER=(uid={edipi})
#
# Header mode: a reverse proxy of yours terminates TLS, verifies the client certificate and
# forwards it (URL-encoded PEM, nginx $ssl_client_escaped_cert) with a shared secret in
# X-ENS-Proxy-Secret. cert-alert refuses to start in this mode without the secret (32+
# characters, e.g. openssl rand -hex 32) and the CA file. Keep TLS off here
# (CERT_ALERT_TLS_ENABLED=false), bind to 127.0.0.1 or the proxy's network, and set
# SERVER_FORWARD_HEADERS_STRATEGY=framework. The proxy's address is the Docker network's
# gateway when it runs on this host, e.g. 172.16.0.0/12.
# ENS_X509_SOURCE=header
# ENS_X509_HEADER=X-SSL-Client-Cert
# ENS_X509_TRUSTED_PROXIES=172.16.0.0/12
# ENS_X509_PROXY_SECRET_FILE=/etc/cert-alert/tls/x509-proxy-secret
# ENS_X509_TRUSTED_CA_FILE=/etc/cert-alert/tls/client-cas.pem

# ---------------------------------------------------------------------------------------
# Your directory's shape
# ---------------------------------------------------------------------------------------

# Must every serverPOC value be an email address? false for a directory holding names.
# CERT_ALERT_LDAP_REQUIRE_EMAIL_POC=true
# Ask for userCertificate;binary. false for a directory with no such attribute to return.
# CERT_ALERT_LDAP_BINARY_CERTIFICATE_OPTION=true
# Entries per LDAP page; turn paging off only for servers without the control.
# CERT_ALERT_LDAP_PAGE_SIZE=500
# CERT_ALERT_LDAP_PAGED=true
# How long to wait on the directory, in milliseconds: for a connection, and for each answer
# (one page of a sweep, one sign-in). Raise the second for a directory that takes longer
# than a minute to return a page.
# CERT_ALERT_LDAP_CONNECT_TIMEOUT_MS=10000
# CERT_ALERT_LDAP_READ_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------------------
# Email - your SMTP server (the expiry round-up and the email alert channel are licensed)
# ---------------------------------------------------------------------------------------

# SPRING_MAIL_HOST=smtp.example.gov
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# How long to wait on the mail server, in milliseconds. Mail that cannot be sent is kept and
# tried again (a minute, then doubling up to an hour apart, for three days).
# CERT_ALERT_MAIL_CONNECT_TIMEOUT_MS=30000
# CERT_ALERT_MAIL_READ_TIMEOUT_MS=30000
# CERT_ALERT_MAIL_WRITE_TIMEOUT_MS=30000

# The daily round-up to each certificate's points of contact.
# CERT_ALERT_NOTIFICATIONS_EMAIL_ENABLED=true
# CERT_ALERT_NOTIFICATIONS_EMAIL_FROM=cert-alert@example.gov
# Build every message and send none - for a first look at who would hear what.
# CERT_ALERT_EMAIL_DRY_RUN=false
# Your own templates, from ./email-templates/email/ next to this file.
# CERT_ALERT_NOTIFICATIONS_EMAIL_TEMPLATE_DIRECTORY=/etc/cert-alert/templates
# How far back the daily round-up still reports a certificate that has already expired
# (0 for no limit).
# CERT_ALERT_NOTIFICATIONS_DIGEST_EXPIRED_LOOK_BACK=90d

# Every alert as it happens, to a fixed list of operators (comma-separated).
# CERT_ALERT_ALERTS_EMAIL_ENABLED=true
# CERT_ALERT_ALERTS_EMAIL_FROM=cert-alert@example.gov
# CERT_ALERT_ALERTS_EMAIL_TO=pki-team@example.gov

# ---------------------------------------------------------------------------------------
# Revocation (licensed)
# ---------------------------------------------------------------------------------------

# Responder or list to ask about a certificate that names none of its own.
# CERT_ALERT_DEFAULT_OCSP_URL=
# CERT_ALERT_DEFAULT_CRL_URL=
# The only hosts CRLs and OCSP answers are fetched from, comma-separated: names, *.domain,
# or addresses and ranges (10.20.0.0/16). Empty: wherever the certificates say - except
# link-local and cloud metadata addresses (never) and loopback (only when named here).
# CERT_ALERT_REVOCATION_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------------------
# Look and thresholds
# ---------------------------------------------------------------------------------------

# Classification bars across the top and bottom of every page.
# CERT_ALERT_BANNER_ENABLED=true
# CERT_ALERT_BANNER_TEXT='UNCLASSIFIED'
# CERT_ALERT_BANNER_TEXT_COLOR=#ffffff
# CERT_ALERT_BANNER_BACKGROUND=#007a33

# Days before expiry a certificate counts as expiring, and as critical.
# CERT_ALERT_WARNING_THRESHOLD_DAYS=30
# CERT_ALERT_CRITICAL_THRESHOLD_DAYS=7

# Logs as structured JSON (Elastic Common Schema), one object per line, for a log collector.
# The audit trail's own stdout lines (ENS_AUDIT_STDOUT) are raw ens-audit/1 JSON either way.
# LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs

# Metrics: give the actuator a port of its own, inside the container (it is not published by
# this compose file), where /actuator/health and /actuator/prometheus are open without
# signing in. Unset, Prometheus is not served at all. To scrape from another host, add the
# port to docker-compose.yml yourself, bound to an interface only your Prometheus reaches.
# MANAGEMENT_SERVER_PORT=9090

# JVM options. The default sizes the heap to 75% of the container's memory limit. Setting
# this replaces the default, so keep those two. A directory (ldaps://) or mail server whose
# certificate comes from a private CA needs that CA trusted: put a truststore holding it in
# ./tls and add -Djavax.net.ssl.trustStore=/etc/cert-alert/tls/ca-truststore.p12
# -Djavax.net.ssl.trustStorePassword=... -Djavax.net.ssl.trustStoreType=PKCS12
# JAVA_OPTS='-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError'

# ---------------------------------------------------------------------------------------
# Audit logging (ens-audit/1) - the same variables in every ENS product
# ---------------------------------------------------------------------------------------
# The trail is always kept in the database and shown at /admin/audit. These add copies for
# a SIEM. Never put the Splunk token anywhere but here or in a file it is read from.

# Each event as one raw JSON line on the container's stdout (Docker logs, Splunk UF).
# ENS_AUDIT_STDOUT=true
# A JSONL file as well, rotated daily or at 100 MB, in the ens-audit volume.
# ENS_AUDIT_FILE=/var/log/ens/certalert/audit.jsonl
# How many rotated files to keep.
# ENS_AUDIT_FILE_KEEP=30
# Days to keep events; 0 keeps them forever. Only events every output has delivered are
# pruned, and never the newest. (cert-alert.audit.retention.* still works when this is 0.)
# ENS_AUDIT_RETENTION_DAYS=0

# Splunk HTTP Event Collector. Off while the URL is empty.
# ENS_AUDIT_SPLUNK_URL=https://splunk.example.gov:8088
# ENS_AUDIT_SPLUNK_TOKEN=
# Or read the token from a file mounted into the container.
# ENS_AUDIT_SPLUNK_TOKEN_FILE=/etc/cert-alert/tls/splunk-hec.token
# ENS_AUDIT_SPLUNK_INDEX=
# ENS_AUDIT_SPLUNK_SOURCETYPE=ens:audit
# Skips TLS verification. Test setups only; a warning is logged at startup.
# ENS_AUDIT_SPLUNK_INSECURE=false

# Syslog, RFC 5424 (octet-counted over tcp and tls). Off while the host is empty.
# ENS_AUDIT_SYSLOG_HOST=syslog.example.gov
# Default 514 for udp and tcp, 6514 for tls.
# ENS_AUDIT_SYSLOG_PORT=
# udp, tcp or tls.
# ENS_AUDIT_SYSLOG_PROTOCOL=tcp
# ENS_AUDIT_SYSLOG_FACILITY=local0

# ---------------------------------------------------------------------------------------
# License
# ---------------------------------------------------------------------------------------
# The license itself, as an alternative to license/license.lic or an upload on the license
# screen: the token between the license file's BEGIN and END lines, or the whole file
# base64-encoded (base64 -w0 license.lic). It is installed at start if no license is installed
# yet, or if it is a newer revision of the installed one; otherwise the installed license is
# kept. Leave it empty to supply the license another way.
ENS_LICENSE=
