          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockPrivateNetworks": {
          "type": [
            "boolean",
            "string"
          ],
          "enum": [
            true,
            false,
            "",
            "true",
            "false"
          ],
          "description": "Empty: refuse private addresses for webhooks saved from now on (older ones keep theirs until their URL changes); true: refuse for all; false: allow for all."
        },
        "secretKey": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string"
        },
        "generateSecretKey": {
          "type": "boolean",
          "description": "Generate secretKey on a new installation when none is given (kept across upgrades by lookup)."
