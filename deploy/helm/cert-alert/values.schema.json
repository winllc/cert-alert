          "type": "string",
          "pattern": "^$|^[0-9]+(ms|s|m|h|d)$|^P"
        }
      }
    },
    "webhooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
