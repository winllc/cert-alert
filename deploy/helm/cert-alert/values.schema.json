          "type": [
            "boolean",
            "null"
          ]
        },
        "binaryCertificateOption": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "pageSize": {
          "type": [
            "integer",
            "null"
          ]
        },
        "paged": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "changelogEnabled": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "adminIdentifiers": {
          "description": "uids or entry DNs granted the admin role. An e-mail address is ignored, with a warning at startup.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ldap": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "userSearchBase": {
              "type": "string"
            },
            "userSearchFilter": {
              "type": "string"
            },
            "userDnPatterns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "auditorIdentifiers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "uids or entry DNs granted the read-only auditor role."
        },
        "groups": {
          "type": "object",
          "properties": {
            "admin": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "auditor": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "directory": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "memberOfAttribute": {
              "type": "string"
            }
          }
        }
      }
    },
    "sso": {
      "type": "object",
      "properties": {
        "publicUrl": {
          "type": "string",
          "description": "Absolute address people reach CertAlert at; required with single sign-on."
        },
        "oidc": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "displayName": {
              "type": "string"
            },
            "issuerUri": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            },
            "clientSecret": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string"
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "usernameClaim": {
              "type": "string"
            },
            "match": {
              "type": "string",
              "enum": [
                "",
                "UID",
                "DN",
                "uid",
                "dn"
              ]
            },
            "groupsClaim": {
              "type": "string"
            },
            "jwsAlgorithm": {
              "type": "string"
            },
            "clockSkew": {
              "type": "string"
            },
            "adminGroups": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "auditorGroups": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "providerLogout": {
              "type": [
                "boolean",
                "string"
              ],
              "enum": [
                true,
                false,
                "",
                "true",
                "false"
              ],
              "description": "Sign out at the provider too (RP-initiated logout). Empty: true on a new installation, kept as it was on an upgrade."
            }
          }
        },
        "saml": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "displayName": {
              "type": "string"
            },
            "metadataUrl": {
              "type": "string"
            },
            "metadataConfigMap": {
              "type": "string"
            },
            "metadataConfigMapKey": {
              "type": "string"
            },
            "entityId": {
              "type": "string"
            },
            "signingSecret": {
              "type": "string"
            },
            "usernameAttribute": {
              "type": "string"
            },
            "match": {
              "type": "string",
              "enum": [
                "",
                "UID",
                "DN",
                "uid",
                "dn"
              ]
            },
            "groupsAttribute": {
              "type": "string"
            },
            "clockSkew": {
              "type": "string"
            },
            "adminGroups": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "auditorGroups": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "tls": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "keystore": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "passwordExistingSecret": {
              "type": "string"
            },
            "passwordExistingSecretKey": {
              "type": "string"
            }
          }
        },
        "truststore": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "passwordExistingSecret": {
              "type": "string"
            },
            "passwordExistingSecretKey": {
              "type": "string"
            }
          }
        }
      }
    },
    "x509": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "servlet",
            "header"
          ]
        },
        "header": {
          "type": "string"
        },
        "trustedProxies": {
          "type": "string"
        },
        "proxySecret": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        "trustedCa": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        "revocation": {
          "description": "ENS_X509_REVOCATION. Empty: ocsp-then-crl, soft-fail.",
          "type": "string",
          "enum": [
            "",
            "off",
            "ocsp",
            "crl",
            "ocsp-then-crl"
          ]
        },
        "ocspResponderUrl": {
          "type": "string"
        },
        "revocationFail": {
          "description": "ENS_X509_REVOCATION_FAIL. Empty: open while revocation is empty, closed once it is set.",
          "type": "string",
          "enum": [
            "",
            "closed",
            "open"
          ]
        },
        "revocationCache": {
          "type": "string"
        },
        "allowedIssuers": {
          "type": "string"
        },
        "userFilter": {
          "type": "string"
        }
      }
    },
    "caTruststore": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "passwordExistingSecret": {
          "type": "string"
        },
        "passwordExistingSecretKey": {
          "type": "string"
        }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string"
        },
        "params": {
          "type": "string"
        },
        "poolSize": {
          "type": [
            "integer",
            "null"
          ]
        },
        "embedded": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string"
                },
                "tag": {
                  "type": "string"
                },
                "digest": {
                  "type": "string"
                },
                "pullPolicy": {
                  "type": "string",
                  "enum": [
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              }
            },
            "persistence": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "size": {
                  "type": "string"
                },
                "storageClass": {
                  "type": "string"
                },
                "accessModes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "existingClaim": {
                  "type": "string"
                }
              }
            },
            "resources": {
              "type": "object"
            },
            "podSecurityContext": {
              "type": "object"
            },
            "containerSecurityContext": {
              "type": "object"
            },
            "nodeSelector": {
              "type": "object"
            },
            "tolerations": {
              "type": "array"
            },
            "affinity": {
              "type": "object"
            }
          }
        }
      }
    },
    "mail": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": [
            "integer",
