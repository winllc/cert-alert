    "notifications": {
      "type": "object",
      "properties": {
        "email": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "from": {
              "type": "string"
            },
            "dryRun": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "templatesConfigMap": {
              "type": "string"
            }
          }
        }
      }
    },
    "alerts": {
      "type": "object",
      "properties": {
        "email": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "from": {
              "type": "string"
            },
            "to": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "revocation": {
      "type": "object",
      "properties": {
        "defaultOcspUrl": {
          "type": "string"
