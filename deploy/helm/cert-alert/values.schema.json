        "defaultCrlUrl": {
          "type": "string"
        },
        "allowedHosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "session": {
      "type": "object",
      "properties": {
        "idleTimeout": {
          "type": "string"
        },
        "adminIdleTimeout": {
          "type": "string"
        },
        "absoluteTimeout": {
          "type": "string"
        },
        "maxPerUser": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "store": {
          "type": "string",
          "enum": [
            "",
            "jdbc",
            "memory"
          ]
        }
      }
    },
    "consentBanner": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "banner": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "textColor": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "height": {
          "type": "string"
        }
      }
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "warningDays": {
          "type": [
            "integer",
            "null"
          ]
        },
        "criticalDays": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "scrapeTimeout": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            }
          }
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object"
            },
            "alertLabels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "selector": {
              "type": "string"
            },
            "jobLabel": {
              "type": "string",
              "minLength": 1
            },
            "jobs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "job",
                  "maxAgeSeconds"
                ],
                "properties": {
                  "job": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxAgeSeconds": {
                    "type": "integer",
                    "minimum": 60
                  },
                  "severity": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "jobFor": {
              "type": "string",
              "pattern": "^([0-9]+(ms|s|m|h|d|w|y))+$"
            },
            "jobSeverity": {
              "type": "string",
              "minLength": 1
            },
            "digestTruncated": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "severity": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "revocationUnknown": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "severity": {
                  "type": "string",
                  "minLength": 1
                },
                "threshold": {
                  "type": "integer",
                  "minimum": 0
                },
                "for": {
                  "type": "string",
                  "pattern": "^([0-9]+(ms|s|m|h|d|w|y))+$"
                }
              }
            },
            "certificatesExpiring": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "severity": {
                  "type": "string",
                  "minLength": 1
                },
                "threshold": {
                  "type": "integer",
                  "minimum": 0
                },
                "for": {
                  "type": "string",
                  "pattern": "^([0-9]+(ms|s|m|h|d|w|y))+$"
                }
              }
            }
          }
        },
        "allowFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "logFormat": {
      "type": "string",
      "enum": [
        "text",
        "json"
      ]
    },
    "javaOpts": {
      "type": "string"
    },
    "exports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxRows": {
          "type": "integer",
          "minimum": 1
        },
        "reportMaxRows": {
          "type": "integer",
          "minimum": 1
        },
        "reportRecipientDomains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
