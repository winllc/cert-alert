# ENS licenses and signing keys are never committed. The exceptions are the license
# fixtures under src/test/resources, signed with the ENS portal's published TEST key, which
# only the tests trust.
*.lic
!src/test/resources/license/fixtures/*.lic
*private.pem
# Where a license is put for docker compose to copy into its volume.
/license/

# Release bundles built by scripts/release-bundle.sh.
/dist/

# The accessibility scan's Node packages (a11y/package-lock.json pins them)
a11y/node_modules/
